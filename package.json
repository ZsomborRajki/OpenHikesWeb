{
	"name": "openhikes-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint . && stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write . && stylelint \"src/**/*.{css,svelte}\" --fix",
		"analyze": "knip --treat-config-hints-as-errors && knip --cycles",
		"test:unit": "vitest run --coverage",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:live": "E2E_LIVE_MAP=1 playwright test --project desktop",
		"verify": "npm run lint && npm run check && npm run analyze && npm run test:unit && npm run test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.6.0",
		"jsdom": "^31.0.1",
		"knip": "^6.45.1",
		"postcss-html": "^2.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"stylelint": "^18.0.0",
		"stylelint-config-standard": "^41.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.1.0",
		"wrangler": "^4.164.0"
	},
	"dependencies": {
		"@apple/mapkit-loader": "^1.0.0",
		"@lucide/svelte": "^1.73.0",
		"idb": "^8.0.4"
	}
}
